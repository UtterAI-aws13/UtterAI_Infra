grafana_admin_credentials_enabled = true

kubecost_enabled                   = true
# Kubecost cost history is backed by the configured S3 object store.
# Keep the chart PVC disabled unless an EBS StorageClass is intentionally used.
kubecost_persistent_volume_enabled = false

# CloudFront custom domain for the prod frontend.
cloudfront_aliases     = ["app.utterai.org"]
route53_hosted_zone_id = "Z06102331M4SC2S9CO5RJ"

# Optional: use an existing us-east-1 ACM certificate instead of creating one.
# cloudfront_acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/..."

# CloudFront WAF v1 starts in Count mode. Review metrics before changing rules to Block.
cloudfront_waf_enabled    = true
cloudfront_waf_rate_limit = 2000
