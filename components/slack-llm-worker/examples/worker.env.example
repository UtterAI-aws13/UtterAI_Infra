# Non-secret configuration only. Do not commit a real .env or long-lived AWS keys.
AWS_DEFAULT_REGION=ap-northeast-2
SLACK_APP_ID=REPLACE_APP_ID
SLACK_TEAM_ID=REPLACE_TEAM_ID
SLACK_CHANNELS=REPLACE_TEST_CHANNEL_ID
SLACK_USERS=REPLACE_ALLOWED_USER_ID
SLACK_BOT_ID=REPLACE_BOT_USER_ID
QUEUE_URL=REPLACE_STACK_OUTPUT
STATE_TABLE=REPLACE_STACK_OUTPUT
SLACK_BOT_SECRET_ARN=REPLACE_BOT_SECRET_ARN
BEDROCK_MODEL_ID=REPLACE_APPROVED_MODEL_ID
WORKER_CONCURRENCY=2
# Paid runtime refuses to start while disabled.
ENABLE_PAID_MODEL=disabled
