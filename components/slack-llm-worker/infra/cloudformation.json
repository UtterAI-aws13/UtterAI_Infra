{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "REVIEW ONLY: Slack async worker. Creates billable resources. No ECS Service, VPC, secrets or model calls. Task disabled until approved.",
  "Parameters": {
    "CodeBucket": {
      "Type": "String"
    },
    "CodeKey": {
      "Type": "String"
    },
    "CodeVersion": {
      "Type": "String"
    },
    "SigningSecretArn": {
      "Type": "String"
    },
    "BotSecretArn": {
      "Type": "String"
    },
    "SlackAppId": {
      "Type": "String"
    },
    "SlackTeamId": {
      "Type": "String"
    },
    "SlackChannels": {
      "Type": "String"
    },
    "SlackUsers": {
      "Type": "String"
    },
    "SlackBotId": {
      "Type": "String"
    },
    "WorkerImage": {
      "Type": "String"
    },
    "BedrockModelId": {
      "Type": "String"
    },
    "BedrockResources": {
      "Type": "CommaDelimitedList",
      "Description": "Exact approved model/profile ARNs; never wildcard. Include underlying model ARNs for inference profiles."
    },
    "ECRRepository": {
      "Type": "String",
      "Description": "Existing repository name matching digest-pinned WorkerImage"
    }
  },
  "Resources": {
    "DLQ": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "SqsManagedSseEnabled": true,
        "MessageRetentionPeriod": 1209600
      }
    },
    "Queue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "SqsManagedSseEnabled": true,
        "MessageRetentionPeriod": 345600,
        "VisibilityTimeout": 90,
        "ReceiveMessageWaitTimeSeconds": 20,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "DLQ",
              "Arn"
            ]
          },
          "maxReceiveCount": 8
        }
      }
    },
    "State": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        },
        "TimeToLiveSpecification": {
          "AttributeName": "expires",
          "Enabled": true
        }
      }
    },
    "IngressLog": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-ingress"
        },
        "RetentionInDays": 7
      }
    },
    "WorkerLog": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 7
      }
    },
    "IngressRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "scoped-access",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:SendMessage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Queue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": {
                    "Ref": "SigningSecretArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "IngressLog",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Ingress": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-ingress"
        },
        "Runtime": "python3.12",
        "Handler": "slack_worker.runtime.lambda_handler",
        "Role": {
          "Fn::GetAtt": [
            "IngressRole",
            "Arn"
          ]
        },
        "Timeout": 3,
        "MemorySize": 256,
        "ReservedConcurrentExecutions": 2,
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          },
          "S3ObjectVersion": {
            "Ref": "CodeVersion"
          }
        },
        "Environment": {
          "Variables": {
            "SLACK_SIGNING_SECRET_ARN": {
              "Ref": "SigningSecretArn"
            },
            "QUEUE_URL": {
              "Ref": "Queue"
            },
            "SLACK_APP_ID": {
              "Ref": "SlackAppId"
            },
            "SLACK_TEAM_ID": {
              "Ref": "SlackTeamId"
            },
            "SLACK_CHANNELS": {
              "Ref": "SlackChannels"
            },
            "SLACK_USERS": {
              "Ref": "SlackUsers"
            },
            "SLACK_BOT_ID": {
              "Ref": "SlackBotId"
            }
          }
        }
      },
      "DependsOn": "IngressLog"
    },
    "IngressURL": {
      "Type": "AWS::Lambda::Url",
      "Properties": {
        "AuthType": "NONE",
        "TargetFunctionArn": {
          "Fn::GetAtt": [
            "Ingress",
            "Arn"
          ]
        }
      }
    },
    "URLPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunctionUrl",
        "FunctionName": {
          "Ref": "Ingress"
        },
        "Principal": "*",
        "FunctionUrlAuthType": "NONE"
      }
    },
    "InvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "Ingress"
        },
        "Principal": "*",
        "InvokedViaFunctionUrl": true
      }
    },
    "WorkerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "scoped-access",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:ChangeMessageVisibility"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Queue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "State",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": {
                    "Ref": "BotSecretArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock:InvokeModel"
                  ],
                  "Resource": {
                    "Ref": "BedrockResources"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "scoped-access",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/${ECRRepository}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "WorkerLog",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "WorkerTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Cpu": "256",
        "Memory": "512",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "WorkerRole",
            "Arn"
          ]
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "worker",
            "Image": {
              "Ref": "WorkerImage"
            },
            "Essential": true,
            "StopTimeout": 120,
            "ReadonlyRootFilesystem": true,
            "Environment": [
              {
                "Name": "AWS_DEFAULT_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "QUEUE_URL",
                "Value": {
                  "Ref": "Queue"
                }
              },
              {
                "Name": "STATE_TABLE",
                "Value": {
                  "Ref": "State"
                }
              },
              {
                "Name": "SLACK_BOT_SECRET_ARN",
                "Value": {
                  "Ref": "BotSecretArn"
                }
              },
              {
                "Name": "BEDROCK_MODEL_ID",
                "Value": {
                  "Ref": "BedrockModelId"
                }
              },
              {
                "Name": "SLACK_APP_ID",
                "Value": {
                  "Ref": "SlackAppId"
                }
              },
              {
                "Name": "SLACK_TEAM_ID",
                "Value": {
                  "Ref": "SlackTeamId"
                }
              },
              {
                "Name": "SLACK_CHANNELS",
                "Value": {
                  "Ref": "SlackChannels"
                }
              },
              {
                "Name": "SLACK_USERS",
                "Value": {
                  "Ref": "SlackUsers"
                }
              },
              {
                "Name": "SLACK_BOT_ID",
                "Value": {
                  "Ref": "SlackBotId"
                }
              },
              {
                "Name": "WORKER_CONCURRENCY",
                "Value": "2"
              },
              {
                "Name": "ENABLE_PAID_MODEL",
                "Value": "disabled"
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "WorkerLog"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "worker"
              }
            }
          }
        ]
      }
    },
    "DLQAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
              "Fn::GetAtt": [
                "DLQ",
                "QueueName"
              ]
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "ComparisonOperator": "GreaterThanThreshold",
        "Threshold": 0,
        "TreatMissingData": "notBreaching"
      }
    },
    "AgeAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateAgeOfOldestMessage",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
              "Fn::GetAtt": [
                "Queue",
                "QueueName"
              ]
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "ComparisonOperator": "GreaterThanThreshold",
        "Threshold": 180,
        "TreatMissingData": "notBreaching"
      }
    }
  },
  "Outputs": {
    "IngressURL": {
      "Value": {
        "Fn::GetAtt": [
          "IngressURL",
          "FunctionUrl"
        ]
      }
    },
    "QueueURL": {
      "Value": {
        "Ref": "Queue"
      }
    },
    "StateTable": {
      "Value": {
        "Ref": "State"
      }
    },
    "WorkerTask": {
      "Value": {
        "Ref": "WorkerTask"
      }
    },
    "DLQURL": {
      "Value": {
        "Ref": "DLQ"
      }
    }
  }
}
